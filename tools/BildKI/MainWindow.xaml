<Window x:Class="BildKI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BildKI – Bild aus deutschem Prompt"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Fenster_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="360"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Linke Spalte: Eingaben ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Bildmodell" Style="{StaticResource Beschriftung}" Margin="0,0,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbtnFlux" Content="FLUX" GroupName="Modell" IsChecked="True"
                                 Checked="Modell_Changed" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbtnPony" Content="Pony (fotorealistisch, LoRA)" GroupName="Modell"
                                 Checked="Modell_Changed" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Bildbeschreibung (Deutsch)" Style="{StaticResource Beschriftung}" Margin="0,10,0,3"/>
                <TextBox x:Name="TxtDeutsch" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         ToolTip="Stichwortartig, kommagetrennt, z. B.: Hochformat, junge Frau in Regency-Kleid, Ballsaal bei Kerzenlicht, malerische Illustration"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnUebersetzen" Content="Nur übersetzen" Click="BtnUebersetzen_Click"/>
                    <CheckBox x:Name="ChkHochformat" Content="„Hochformat, “ voranstellen" Margin="14,0,0,0"
                              VerticalAlignment="Center" Checked="ChkHochformat_Changed" Unchecked="ChkHochformat_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="ChkScoreTags" Content="Pony-Score-Tags voranstellen" VerticalAlignment="Center"
                              ToolTip="Pony Diffusion wurde mit einem Aesthetic-Score-System trainiert - diese Tag-Kette wird bei Bedarf automatisch unmittelbar vor dem Versand vorangestellt (erscheint bewusst NICHT im Englisch-Feld oben, um die Übersetzungs-Logik nicht zu verwirren)."/>
                </StackPanel>

                <TextBlock Text="Prompt (Englisch) – wird an die Bild-KI gesendet, hier korrigierbar" Style="{StaticResource Beschriftung}"/>
                <TextBox x:Name="TxtEnglisch" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas"/>

                <TextBlock Text="Bildgröße &amp; Schritte" Style="{StaticResource Beschriftung}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbFormat" Grid.Column="0" SelectionChanged="CmbFormat_SelectionChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="Quadrat 1024 × 1024" Tag="1024x1024"/>
                        <ComboBoxItem Content="Hochformat 768 × 1024" Tag="768x1024"/>
                        <ComboBoxItem Content="Hochformat 832 × 1216" Tag="832x1216"/>
                        <ComboBoxItem Content="Querformat 1024 × 768" Tag="1024x768"/>
                        <ComboBoxItem Content="Querformat 1216 × 832" Tag="1216x832"/>
                        <ComboBoxItem Content="Eigene Größe" Tag=""/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtBreite" Grid.Column="2" TextChanged="Groesse_TextChanged"/>
                    <TextBlock Grid.Column="3" Text="H" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="TxtHoehe" Grid.Column="4" TextChanged="Groesse_TextChanged"/>
                    <TextBlock Grid.Column="5" Text="Schritte" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="TxtSchritte" Grid.Column="6" ToolTip="FLUX.1-schnell: 4 Schritte reichen. Pony: 24-30 empfohlen (kein Turbo-Modell)."/>
                </Grid>

                <Button x:Name="BtnGenerieren" Content="Übersetzen &amp; Bild erzeugen" Click="BtnGenerieren_Click"
                        Margin="0,16,0,0" Height="40" FontSize="15" FontWeight="SemiBold"
                        ToolTip="Ist das englische Feld leer, wird zuerst übersetzt; sonst wird der englische Text direkt verwendet."/>
                <Button x:Name="BtnAbbrechen" Content="Abbrechen" Click="BtnAbbrechen_Click" Margin="0,6,0,0" IsEnabled="False"/>

                <!-- Einstellungen -->
                <Expander Header="Einstellungen" Margin="0,18,0,0" IsExpanded="False">
                    <StackPanel Margin="4,6,0,0">
                        <TextBlock Text="sd-server-URL FLUX" Style="{StaticResource Beschriftung}" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSdUrl"/>
                        <TextBlock Text="sd-server-URL Pony" Style="{StaticResource Beschriftung}"/>
                        <TextBox x:Name="TxtSdUrlPony"/>
                        <TextBlock Text="Pony: CFG / Sampler / LoRA (Datei, Gewicht) - Schritte oben im Feld „Schritte“" Style="{StaticResource Beschriftung}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCfgPony" Grid.Column="0" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtSampleMethodPony" Grid.Column="1" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtLoraPfadPony" Grid.Column="2" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtLoraGewichtPony" Grid.Column="3"/>
                        </Grid>
                        <TextBlock Text="Ollama-URL (Übersetzung)" Style="{StaticResource Beschriftung}"/>
                        <TextBox x:Name="TxtOllamaUrl"/>
                        <TextBlock Text="Ollama-Modell" Style="{StaticResource Beschriftung}"/>
                        <TextBox x:Name="TxtOllamaModell"/>
                        <TextBlock Text="Zeitlimit pro Bild (Sekunden)" Style="{StaticResource Beschriftung}"/>
                        <TextBox x:Name="TxtTimeout" Width="90" HorizontalAlignment="Left"/>

                        <TextBlock Text="Speicherordner" Style="{StaticResource Beschriftung}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOrdner" Grid.Column="0"/>
                            <Button Grid.Column="1" Content="…" MinWidth="34" Margin="6,0,0,0" Click="BtnOrdnerWaehlen_Click"/>
                        </Grid>
                        <CheckBox x:Name="ChkAutoSpeichern" Content="Jedes fertige Bild automatisch dort speichern" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ChkPromptDatei" Content="Prompt als .txt neben dem Bild ablegen" Margin="0,4,0,0"/>

                        <TextBlock Text="Negativ-Prompt (fest mitgesendet)" Style="{StaticResource Beschriftung}"/>
                        <TextBox x:Name="TxtNegativ" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" FontSize="11" FontFamily="Consolas"/>

                        <Button Content="Einstellungen speichern" Click="BtnEinstellungenSpeichern_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

        <!-- ============ Rechte Spalte: Bild ============ -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Background="#F4F4F4" CornerRadius="4">
                <Grid>
                    <TextBlock x:Name="LblPlatzhalter" Text="Hier erscheint das erzeugte Bild."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" FontSize="14"/>
                    <Image x:Name="ImgErgebnis" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <TextBlock x:Name="LblGespeichert" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#444"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                <Button x:Name="BtnSpeichernUnter" Content="Speichern unter…" Click="BtnSpeichernUnter_Click" IsEnabled="False"/>
                <Button x:Name="BtnKopieren" Content="In Zwischenablage" Click="BtnKopieren_Click" IsEnabled="False" Margin="6,0,0,0"/>
                <Button Content="Ordner öffnen" Click="BtnOrdnerOeffnen_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============ Statuszeile ============ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblStatus" Grid.Column="0" Text="Bereit." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="PrgStatus" Grid.Column="1" Height="16" IsIndeterminate="False" Visibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
